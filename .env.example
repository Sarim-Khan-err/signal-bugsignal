# Copy this file to .env.local for local development. Keep secrets private.
# Production should use the host's encrypted environment variable settings.

# Local-only fallback. Used only when Supabase is not configured and NODE_ENV is not production.
SIGNAL_SESSION_SECRET=
SIGNAL_NORTHSTAR_PASSWORD=
SIGNAL_ORBIT_PASSWORD=

# Hosted accounts + report database (Supabase project URL and publishable/anon key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Transactional customer updates (Resend; sender domain must be verified).
RESEND_API_KEY=
SIGNAL_FROM_EMAIL=

# Fastn integration embed (server-only partner key with customer provisioning permission).
FASTN_API_KEY=
FASTN_BASE_URL=https://api.fastn.dev
